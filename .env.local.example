# Local development: point at the API so /login and the workspace work.
# Production (DigitalOcean): set the same name as a build-time env var with the
# public API origin, for example https://api.example.com. Next.js inlines it
# during `npm run build`. Omit it for a marketing-only deploy so the login
# form is not shown.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
