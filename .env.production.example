# ==============================================================================
# Paytrix Web App (bills-app) — Production Environment Configuration
#
# IMPORTANT (Next.js + Docker / DigitalOcean App Platform):
# `NEXT_PUBLIC_API_BASE_URL` MUST be available at BOTH build time and runtime
# (`RUN_AND_BUILD_TIME` in DigitalOcean App Platform, or `--build-arg` in Docker),
# because Next.js inlines `NEXT_PUBLIC_*` into client bundles during `npm run build`
# AND `src/middleware.ts` reads it at runtime.
# ==============================================================================

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
HOSTNAME=0.0.0.0
PORT=8080

# Public HTTPS URL of `bills-api` (NO trailing slash)
NEXT_PUBLIC_API_BASE_URL=https://api.paytrix.in
